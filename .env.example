# 이 파일을 복사해 .env 로 만들고 실제 값을 채워 사용하세요.
# .env 는 .gitignore 에 포함되어 저장소에 올라가지 않습니다.

# Flask 세션 서명 키 (임의의 긴 문자열)
FLASK_SECRET_KEY=change-this-to-a-random-string

# 이카운트 ERP OpenAPI 접속 정보
ECOUNT_COM_CODE=회사코드
ECOUNT_USER_ID=API_사용자ID
ECOUNT_API_CERT_KEY=API_인증키
ECOUNT_ZONE=CA

# 관리자 계정
ADMIN_ID=admin
ADMIN_PW=changeme

# 데모 모드 강제 활성화 (API 키가 비어 있으면 자동으로 켜집니다)
# DEMO_MODE=true
